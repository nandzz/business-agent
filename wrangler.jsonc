{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nandzz-business-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatQueue"] }],
  // Non-secret defaults. Secrets go in .dev.vars locally (see .dev.vars.example)
  // and `wrangler secret put` when deployed.
  "vars": {
    "GRAPH_API_VERSION": "v23.0",
    "MCP_AGENT_URL": "https://tbzxiuciztqmbnzvtryp.supabase.co/functions/v1/mcp-agent",
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-transcribe",
    "DEBOUNCE_MS": "3000",
    "MAX_WAIT_MS": "8000",
    "MAX_INPUT_MESSAGES": "20",
    "TAKEOVER_PAUSE_MIN": "5",
    "DRY_RUN": "0",
    "DEBUG_ROUTES": "0"
  }
}
